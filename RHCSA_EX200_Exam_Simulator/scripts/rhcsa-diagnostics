#!/usr/bin/env bash
set -u
WEBUI_PORT="${RHCSA_WEBUI_PORT:-8080}"
TERMINAL_PORT="${RHCSA_TERMINAL_PORT:-7682}"
INSTALL_DIR="${RHCSA_INSTALL_DIR:-/usr/local/share/rhcsa}"
TMUX_BIN="$(command -v tmux 2>/dev/null || true)"
TTYD_BIN="$(command -v ttyd 2>/dev/null || true)"
section(){ printf '\n== %s ==\n' "$1"; }
section Installation
ls -ld "$INSTALL_DIR" /usr/bin/rhcsa /usr/bin/rhcsa-status 2>&1 || true
[[ -f "$INSTALL_DIR/.version" ]] && echo "Version: $(cat "$INSTALL_DIR/.version")"
[[ -d "$INSTALL_DIR/questions" ]] && echo "Chapters: $(find "$INSTALL_DIR/questions" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | awk '/^[0-9]+$/' | sort -n | tr '\n' ' ')"
section Systemd
systemctl --no-pager --full status rhcsa-webui.service rhcsa-terminal.service rhcsa-update.timer 2>&1 || true
section Ports
ss -ltnp 2>&1 | grep -E ":(${WEBUI_PORT}|${TERMINAL_PORT})[[:space:]]" || true
section API
f="$(mktemp)"; trap 'rm -f "$f"' EXIT
if curl -fsS --max-time 5 "http://127.0.0.1:${WEBUI_PORT}/api/objectives" >"$f"; then
  python3 - "$f" <<'PYDIAG'
import json,sys
d=json.load(open(sys.argv[1]))
print(f"OK: {len(d)} chapters returned")
print("IDs:"," ".join(str(x.get("id")) for x in d))
PYDIAG
else
  echo "ERROR: Web API not reachable on 127.0.0.1:${WEBUI_PORT}"
fi
section URLs
echo "http://127.0.0.1:${WEBUI_PORT}"
ip -4 -o addr show scope global 2>/dev/null | awk -v p="$WEBUI_PORT" '{split($4,a,"/"); print "http://" a[1] ":" p}' | awk '!seen[$0]++'
section Logs
journalctl -u rhcsa-webui.service -u rhcsa-terminal.service -n 80 --no-pager 2>&1 || true
