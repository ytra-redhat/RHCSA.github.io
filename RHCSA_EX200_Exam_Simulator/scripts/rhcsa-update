#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/load_repository.sh"

VERSION_FILE="${INSTALL_DIR}/.version"
INSTALLER="${INSTALL_DIR}/installer/Install_RHCSA_EX200_Exam_Simulator.sh"
QUIET=false
CHECK_ONLY=false
FORCE=false

for arg in "$@"; do
  case "$arg" in
    --quiet) QUIET=true ;;
    --check) CHECK_ONLY=true ;;
    --force|--auto) FORCE=true ;;
    *) echo "Unknown argument: $arg" >&2; exit 2 ;;
  esac
done

latest_commit="$(
  curl --fail --silent --show-error --location \
    -H 'Accept: application/vnd.github+json' \
    -H 'User-Agent: RHCSA-Exam-Simulator' \
    "${RHCSA_GITHUB_API_URL}/commits/${RHCSA_GITHUB_BRANCH}" |
  python3 -c 'import json,sys; print(json.load(sys.stdin).get("sha",""))'
)"

installed_commit=""
[[ -f "$VERSION_FILE" ]] && installed_commit="$(tr -d '[:space:]' < "$VERSION_FILE")"

if [[ -n "$installed_commit" && "$installed_commit" == "$latest_commit" ]]; then
  $QUIET || echo "RHCSA simulator is up to date (${installed_commit:0:7})."
  exit 0
fi

if $CHECK_ONLY; then
  $QUIET || printf 'Update available: installed=%s latest=%s\n' \
    "${installed_commit:-unknown}" "$latest_commit"
  exit 10
fi

if [[ ! -x "$INSTALLER" ]]; then
  echo "ERROR: installed update installer not found: $INSTALLER" >&2
  exit 1
fi

$QUIET || printf 'Updating RHCSA simulator to %s from %s...\n' \
  "${latest_commit:0:7}" "$RHCSA_GITHUB_REPOSITORY"

args=(--force --non-interactive)
$FORCE && args+=(--auto-update)
exec "$INSTALLER" "${args[@]}"
